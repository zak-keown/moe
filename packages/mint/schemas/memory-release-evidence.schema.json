{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memory-release-evidence.schema.json",
  "title": "Memory Release Evidence",
  "description": "Package-specific runtime and recovery evidence for the moe-memory artifact, bound to the candidate's artifact integrity.",
  "type": "object",
  "required": [
    "schema",
    "memory_version",
    "artifact_integrity",
    "runtime_matrix",
    "recovery_capsules"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "memory_version": {
      "type": "string",
      "minLength": 1,
      "description": "Exact Memory package version (e.g. 0.2.0)."
    },
    "artifact_integrity": {
      "type": "string",
      "pattern": "^sha512-[A-Za-z0-9+/]+=*$",
      "description": "Tarball integrity hash binding this evidence to the candidate."
    },
    "artifact_tree_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime_matrix": {
      "type": "object",
      "required": ["node_lanes", "native_targets", "database_only_targets"],
      "additionalProperties": false,
      "properties": {
        "node_lanes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 3,
          "description": "Required Node version lanes (e.g. 22.13.0, 22.23.2, 24.20.0)."
        },
        "native_targets": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 4,
          "description": "Native runtime targets (e.g. darwin-arm64, darwin-x64, linux-arm64, linux-x64)."
        },
        "database_only_targets": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Targets receiving database-asset smoke only (e.g. win32-x64)."
        }
      }
    },
    "recovery_capsules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target", "version", "sha256"],
        "additionalProperties": false,
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1,
            "description": "Recovery capsule target (e.g. darwin-arm64)."
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "description": "Recovery capsule version (e.g. 0.1.5)."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "asset": {
            "type": "string",
            "minLength": 1,
            "description": "Release asset filename for this capsule."
          }
        }
      },
      "minItems": 4,
      "description": "One capsule per supported native target."
    }
  }
}
