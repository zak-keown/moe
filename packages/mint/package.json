{
  "name": "@bubstack/moe-mint",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Generate native plugin manifests for every harness from one config. The monorepo's plugin build step.",
  "license": "MIT",
  "bin": {
    "moe-mint": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "checks"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty && tsc -p tsconfig.tests.json --pretty",
    "test": "vitest run",
    "lint": "biome check ."
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "commander": "^14.0.0",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
