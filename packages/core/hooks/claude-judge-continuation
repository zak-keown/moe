#!/bin/bash

# Stop hook: ask a cheap model whether the assistant still has autonomous work
# to do, and block the stop if it does.
#
# OPT-IN. Set MOE_LATTE_ENABLED to a truthy value to arm it. It is off by
# default because it overrides the agent's own decision to stop and spends a
# model call on every stop attempt; see packages/core/README.md.
#
# Forked from double-shot-latte @ dfe7567 (MIT). DEFAULT STANCE: stop unless the
# assistant explicitly stated what it would do next.

# ---------------------------------------------------------------- opt-in gate
case "${MOE_LATTE_ENABLED:-}" in
    ""|0|false|FALSE|no|NO|off|OFF)
        exit 0
        ;;
esac

# Clean up any background jobs on exit to avoid orphaned claude processes
cleanup() {
    pids=$(jobs -p 2>/dev/null)
    if [ -n "$pids" ]; then
        kill $pids 2>/dev/null
    fi
}
trap cleanup EXIT TERM INT HUP

# Every fall-through below allows the stop. Upstream they were silent, which
# made "the judge said stop", "the judge timed out" and "the judge binary is
# missing" one indistinguishable outcome — the reason a missing `timeout`
# turned the whole hook into a no-op without anyone noticing. Say which.
allow_stop() {
    printf 'moe-latte: %s\n' "$1" >&2
    printf '{"decision": "approve", "reason": "%s"}\n' "$1"
    exit 0
}

# Check if we're in a recursive call (judge instance)
if [ "$MOE_LATTE_JUDGE_MODE" = "true" ]; then
    allow_stop "running in judge mode, allowing stop"
fi

command -v jq >/dev/null 2>&1 || allow_stop "jq not found on PATH"
command -v claude >/dev/null 2>&1 || allow_stop "claude CLI not found on PATH"

# Read the hook event data
EVENT=$(cat)

# Extract key information
STOP_HOOK_ACTIVE=$(echo "$EVENT" | jq -r '.stop_hook_active // false')
TRANSCRIPT_PATH=$(echo "$EVENT" | jq -r '.transcript_path // ""')

# Working and state directory. Upstream used $HOME/.claude/double-shot-latte and
# a world-writable /tmp/.claude-continue-throttle-<session> file; both move under
# $HOME/.claude/moe/latte so a machine that still has the upstream plugin
# installed does not share throttle counters with this one.
MOE_LATTE_DIR="$HOME/.claude/moe/latte"
THROTTLE_DIR="$MOE_LATTE_DIR/throttle"
mkdir -p "$MOE_LATTE_DIR" "$THROTTLE_DIR"

SESSION_ID=$(echo "$EVENT" | jq -r '.session_id // "unknown"')
THROTTLE_FILE="$THROTTLE_DIR/$(echo "$SESSION_ID" | tr '/' '_')"
CURRENT_TIME=$(date +%s)

# If this is already a continuation from a previous stop hook, check time throttling
if [ "$STOP_HOOK_ACTIVE" = "true" ]; then
    # Allow up to 3 continuations in 5 minutes, then force stop
    CONTINUE_COUNT=0
    LAST_CONTINUE_TIME=0
    if [ -f "$THROTTLE_FILE" ]; then
        THROTTLE_DATA=$(cat "$THROTTLE_FILE")
        CONTINUE_COUNT=$(echo "$THROTTLE_DATA" | cut -d: -f1)
        LAST_CONTINUE_TIME=$(echo "$THROTTLE_DATA" | cut -d: -f2)
    fi

    TIME_SINCE_LAST=$((CURRENT_TIME - LAST_CONTINUE_TIME))

    # Reset counter if it's been more than 5 minutes
    if [ "$TIME_SINCE_LAST" -gt 300 ]; then
        CONTINUE_COUNT=0
    fi

    # If we've continued too many times recently, force stop
    if [ "$CONTINUE_COUNT" -ge 3 ] && [ "$TIME_SINCE_LAST" -lt 300 ]; then
        rm -f "$THROTTLE_FILE"
        allow_stop "maximum continuation cycles reached in time window, forcing stop"
    fi
fi

# Check if we have a transcript path
if [ -z "$TRANSCRIPT_PATH" ] || [ ! -f "$TRANSCRIPT_PATH" ]; then
    allow_stop "no transcript available for evaluation"
fi

# Extract the last few exchanges from the transcript.
# JSONL files have one JSON object per line; lines from parallel agents can be
# megabytes each. Take the last 4 lines then cap total size so the judge model
# gets classification-level context, not a firehose.
RECENT_CONTEXT=$(tail -n 4 "$TRANSCRIPT_PATH" | jq -s '.' 2>/dev/null | head -c 32000)

# An empty context classifies as STOP every time ("default to STOP when
# uncertain"), which upstream did silently whenever a partial JSONL write made
# `jq -s` fail. Say so instead.
if [ -z "$RECENT_CONTEXT" ]; then
    allow_stop "transcript tail did not parse as JSON, nothing to classify"
fi

# Create a JSON schema for the response
JSON_SCHEMA='{"type":"object","properties":{"should_continue":{"type":"boolean"},"reasoning":{"type":"string"}},"required":["should_continue","reasoning"]}'

# System prompt to establish evaluator identity (not a coding agent)
SYSTEM_PROMPT="You are a conversation state classifier. Your only job is to analyze conversation transcripts and determine if the assistant has more autonomous work to do. You output structured JSON. You do not write code or use tools."

# Create the evaluation prompt
EVALUATION_PROMPT="Analyze this conversation and determine: Does the assistant have more autonomous work to do RIGHT NOW?

Conversation:
$RECENT_CONTEXT

CONTINUE (should_continue: true) ONLY IF the assistant explicitly states what it will do next:
- Phrases indicating intent to continue (e.g., 'Next I need to...', 'Now I'll...', 'Moving on to...')
- Incomplete todo list with remaining items marked pending
- Stated follow-up tasks not yet performed

STOP (should_continue: false) in ALL other cases:

1. TASK COMPLETION - The assistant indicates work is finished:
   - Completion statements (done, complete, finished, ready, all set)
   - Summary of accomplished work with no stated next steps
   - Confirming something is working/verified/installed

2. QUESTIONS - The assistant needs user input:
   - Asking for approval, decisions, clarification, or confirmation
   - Offering optional actions (e.g., 'Want me to...?', 'Should I also...?')
   - Note: Mid-task continuation questions (e.g., 'Should I continue?' when work is ongoing) = CONTINUE

3. BLOCKERS - The assistant cannot proceed:
   - Unresolved errors or missing information
   - Uncertainty about requirements

KEY: If the assistant is WAITING for the user (whether after completing work OR asking a question), that means STOP. Waiting ≠ more autonomous work to do.

Default to STOP when uncertain."

# `timeout` is GNU coreutils and is NOT present on a stock macOS, where upstream
# would exit 127 and allow every stop — the hook installed, fired, reported
# success, and did nothing. Probe for it, accept Homebrew's gtimeout, and run
# without a wrapper when neither exists rather than fail closed.
JUDGE_MODEL="${MOE_LATTE_MODEL:-haiku}"
JUDGE_TIMEOUT="${MOE_LATTE_TIMEOUT:-30}"
if command -v timeout >/dev/null 2>&1; then
    TIMEOUT_CMD=(timeout "$JUDGE_TIMEOUT")
elif command -v gtimeout >/dev/null 2>&1; then
    TIMEOUT_CMD=(gtimeout "$JUDGE_TIMEOUT")
else
    TIMEOUT_CMD=()
    printf 'moe-latte: no timeout(1) or gtimeout(1) on PATH; judge call is unbounded\n' >&2
fi

CLAUDE_RESPONSE=$(cd "$MOE_LATTE_DIR" && echo "$EVALUATION_PROMPT" | \
    MOE_LATTE_JUDGE_MODE=true "${TIMEOUT_CMD[@]}" claude --print \
    --model "$JUDGE_MODEL" \
    --output-format json \
    --json-schema "$JSON_SCHEMA" \
    --system-prompt "$SYSTEM_PROMPT" \
    --disallowedTools '*' 2>/dev/null)
CLAUDE_EXIT_CODE=$?

# Check if claude command succeeded (exit 124 = timeout)
if [ $CLAUDE_EXIT_CODE -ne 0 ]; then
    if [ $CLAUDE_EXIT_CODE -eq 124 ]; then
        allow_stop "judge call timed out after ${JUDGE_TIMEOUT}s"
    else
        allow_stop "judge call failed with exit ${CLAUDE_EXIT_CODE}"
    fi
fi

# Extract the structured output from the claude response (JSON format)
EVALUATION_RESULT=$(echo "$CLAUDE_RESPONSE" | jq '.structured_output // empty' 2>/dev/null)

# If no structured output, fall back to allowing stop
if [ -z "$EVALUATION_RESULT" ] || [ "$EVALUATION_RESULT" = "null" ]; then
    allow_stop "judge response carried no structured_output"
fi

# Parse the evaluation result (should be JSON)
SHOULD_CONTINUE=$(echo "$EVALUATION_RESULT" | jq -r '.should_continue // false')
REASONING=$(echo "$EVALUATION_RESULT" | jq -r '.reasoning // "No reasoning provided"')

# Make the decision based on the judge's evaluation
if [ "$SHOULD_CONTINUE" = "true" ]; then
    # Update throttle tracking
    if [ -f "$THROTTLE_FILE" ]; then
        THROTTLE_DATA=$(cat "$THROTTLE_FILE")
        CONTINUE_COUNT=$(echo "$THROTTLE_DATA" | cut -d: -f1)
        CONTINUE_COUNT=$((CONTINUE_COUNT + 1))
    else
        CONTINUE_COUNT=1
    fi
    echo "$CONTINUE_COUNT:$CURRENT_TIME" > "$THROTTLE_FILE"

    # Block the stop - the judge thinks work remains
    jq -n --arg reason "Judge determined continuation is appropriate: $REASONING" '{
        "decision": "block",
        "reason": $reason
    }'
else
    # Clear throttle file since we're allowing a legitimate stop
    rm -f "$THROTTLE_FILE"

    # Allow the stop - the judge thinks stopping is appropriate
    jq -n --arg reason "Judge determined stopping is appropriate: $REASONING" '{
        "decision": "approve",
        "reason": $reason
    }'
fi

exit 0
