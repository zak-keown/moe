#!/usr/bin/env node
// Stop hook: capture verification EVIDENCE (test/build tool_uses) for
// THIS TURN — bounded by the last human-user boundary in the transcript
// — and a session-cumulative Skill-firing counter, into
// <git-toplevel>/.audit/. Never blocks a stop; only observes.
//
// The two windows are deliberately different: evidence and the completion
// claim it is paired against are BOTH per-turn (a stop event is per-turn,
// so cross-turn evidence is misattribution), while the skill-firing
// counter is session-cumulative (the question it answers — "did any
// core-tier skill fire this session?" — is a session question).
//
// Companion to verification-before-completion/SKILL.md ("evidence before
// claims, always") and the skill-firing signal auditing-progress reasons
// about. Two different silences this makes falsifiable:
//
//   1. The assistant said "tests pass" but no test command ran this turn.
//   2. A skill this tier declares core-tier never fired all session.
//
// DEFAULT-ON. Set MOE_EVIDENCE_DISABLED to a truthy value to disable.
//
// Storage. Always machine-local, never in the worktree — a session's evidence
// can run into the tens of megabytes, too large to keep in a repo even
// gitignored. Follows the precedence packages/memory/src/paths.ts already
// documents as the shared cross-package convention:
//   1. MOE_EVIDENCE_CONFIG_DIR — this hook's dir directly (test seam)
//   2. MOE_DATA_DIR/core/audit/<project-key> — the shared cross-package root
//   3. XDG_CONFIG_HOME/moe/core/audit/<project-key>
//   4. ~/.config/moe/core/audit/<project-key>  (default)
// <project-key> sanitizes the git-toplevel absolute path (falling back to
// cwd outside a repo) rather than just its basename, so two differently
// located repos that happen to share a name never share a record.
//
// -- Extensionless-file / module-type invariant --
// Both packages/core/package.json and every generated plugin package.json
// declare "type": "module". Keep this extensionless executable as ESM in both
// trees; using require() works in neither real location even though it can look
// green when a test copies the file outside its package boundary.

import { execFileSync } from 'node:child_process';
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';

// ---------------------------------------------------------- disabled gate
{
  const raw = String(process.env.MOE_EVIDENCE_DISABLED || '').toLowerCase();
  if (raw && raw !== '0' && raw !== 'false' && raw !== 'no' && raw !== 'off') {
    process.exit(0);
  }
}

// stdin is the hook event. Empty/malformed input is not an error — nothing
// this hook writes affects the stop, so just exit clean.
let event;
try {
  event = JSON.parse(fs.readFileSync(0, 'utf8') || '{}');
} catch (_e) {
  process.exit(0);
}

const sessionId = String(event.session_id || 'unknown').replace(/[^A-Za-z0-9_-]/g, '_');
const transcriptPath = typeof event.transcript_path === 'string' ? event.transcript_path : '';

// ---------------------------------------------------------- output dir
function gitTopLevel() {
  try {
    const top = execFileSync('git', ['rev-parse', '--show-toplevel'], {
      encoding: 'utf8',
      stdio: ['ignore', 'pipe', 'ignore'],
    }).trim();
    if (top) return top;
  } catch (_e) {
    // Not a git repo — fall through.
  }
  return null;
}

function projectKey() {
  const topLevel = gitTopLevel();
  const raw = topLevel || process.cwd();
  return raw.replace(/[^A-Za-z0-9_.-]+/g, '-').replace(/^-+|-+$/g, '') || 'root';
}

function auditRoot() {
  if (process.env.MOE_EVIDENCE_CONFIG_DIR) return process.env.MOE_EVIDENCE_CONFIG_DIR;
  const key = projectKey();
  if (process.env.MOE_DATA_DIR) return path.join(process.env.MOE_DATA_DIR, 'core', 'audit', key);
  if (process.env.XDG_CONFIG_HOME) {
    return path.join(process.env.XDG_CONFIG_HOME, 'moe', 'core', 'audit', key);
  }
  return path.join(os.homedir(), '.config', 'moe', 'core', 'audit', key);
}

const outDir = auditRoot();

try {
  fs.mkdirSync(outDir, { recursive: true });
} catch (_e) {
  process.exit(0);
}

// ---------------------------------------------------------- transcript
// Verification-command allowlist. Pattern-matched against Bash tool_use.input.command,
// leading-anchored so `# not a real: pnpm test` does not match. Broad on
// purpose: false positives here are extra evidence in a JSON file, not a
// blocked stop.
const VERIFY_PATTERNS = [
  /^\s*pnpm\s+(?:--filter\s+\S+\s+)*(?:test|build|lint|typecheck|check|mint(?::check)?|test:python|test:brainstorm|test:shell)\b/,
  /^\s*turbo\s+run\s+/,
  /^\s*(?:npx\s+)?vitest\b/,
  /^\s*(?:npx\s+)?tsc\b/,
  /^\s*(?:npx\s+)?biome\s+check\b/,
  /^\s*python3?\s+-m\s+unittest\b/,
  /^\s*node\s+--check\b/,
];
const isVerify = (cmd) => VERIFY_PATTERNS.some((r) => r.test(cmd));

// Completion-claim phrases. Regex list mirrors what verification-before-completion's
// "Red Flags" enumerates. Detected in the LAST assistant text block only.
// The bare `done|complete|finished|ready|all set` was intentionally dropped:
// it fired on ordinary status prose ("done reading", "ready to try") and
// buried the actual claim-without-evidence signal in noise.
const CLAIM_PATTERNS = [
  /\b(?:tests?|test\s+suite|build|lint|typecheck)\s+(?:pass(?:es|ing|ed)?|succeed(?:s|ed)?|clean|green)\b/i,
  /\ball\s+tests?\s+pass(?:ing|ed)?\b/i,
  /\bverif(?:ied|ication\s+complete)\b/i,
  /\b(?:it|this|that)\s+works\b/i,
];

let transcriptLines = [];
if (transcriptPath && fs.existsSync(transcriptPath)) {
  try {
    transcriptLines = fs.readFileSync(transcriptPath, 'utf8').split('\n');
  } catch (_e) {
    // A truncated transcript is normal mid-write. Nothing to do.
  }
}

// Two passes: first index tool_results by id (they may follow or precede
// their tool_use in JSONL depending on the client) AND remember where the
// last HUMAN user boundary sits, then walk assistant entries only AFTER that
// boundary. Claude serializes tool results as `type:"user"` rows too; treating
// those as prompts cuts the matching assistant tool_use out of the window.
// Without the per-turn cut, evidence and skillsFired would
// accumulate across every stop event since transcript start, and a single
// verifying command near the top of the session would look like proof for
// every later claim — the opposite of what this hook is for.
const toolResults = new Map();
let lastHumanUserIndex = -1;

function isHumanUserEntry(entry) {
  if (!entry || entry.type !== 'user') return false;
  // Claude 2.1.252 serializes the body returned by the Skill tool as a user
  // text row. It is tool-generated metadata, not a new human turn boundary.
  if (
    entry.isMeta === true ||
    entry.turnCompanion === true ||
    typeof entry.sourceToolUseID === 'string'
  ) {
    return false;
  }
  const content = entry.message && entry.message.content;
  if (typeof content === 'string') return true;
  if (!Array.isArray(content)) return false;
  return content.length > 0 && !content.some((item) => item && item.type === 'tool_result');
}

function textContent(content) {
  if (typeof content === 'string') return content;
  if (!Array.isArray(content)) return null;
  return content
    .map((item) => (item && typeof item.text === 'string' ? item.text : ''))
    .join('');
}

function integerOrNull(...values) {
  for (const value of values) {
    if (Number.isInteger(value)) return value;
  }
  return null;
}

for (let i = 0; i < transcriptLines.length; i++) {
  const line = transcriptLines[i];
  if (!line) continue;
  let entry;
  try {
    entry = JSON.parse(line);
  } catch (_e) {
    continue;
  }
  if (isHumanUserEntry(entry)) lastHumanUserIndex = i;
  const content = entry && entry.message && entry.message.content;
  if (!Array.isArray(content)) continue;
  const resultItems = content.filter((item) => item && item.type === 'tool_result');
  for (const item of content) {
    if (item && item.type === 'tool_result' && typeof item.tool_use_id === 'string') {
      // `toolUseResult` is a row-level Claude transcript field. It maps
      // unambiguously only when the row carries one tool_result block.
      const external = resultItems.length === 1 ? entry.toolUseResult : null;
      const output = textContent(item.content);
      const isError = typeof item.is_error === 'boolean' ? item.is_error : null;
      const explicitExitCode = integerOrNull(
        item.exit_code,
        item.exitCode,
        external && external.exit_code,
        external && external.exitCode,
      );
      // Current Claude Bash results omit the numeric exit code on success but
      // do carry is_error:false. Preserve explicit codes when present; infer
      // only the unambiguous successful case and leave failures unknown.
      const exitCode = explicitExitCode === null && isError === false ? 0 : explicitExitCode;
      toolResults.set(item.tool_use_id, { output, isError, exitCode });
    }
  }
}

const evidence = [];
const skillsFired = [];
let lastAssistantText = '';
let turnToolUseCount = 0;

// Per-turn window: only assistant entries after the last human-user boundary
// count toward evidence, skill-firings, and the completion-claim text
// scanned for CLAIM_PATTERNS. First-turn (no prior user entry) still
// works because lastHumanUserIndex = -1 and the loop starts at 0.
for (let i = lastHumanUserIndex + 1; i < transcriptLines.length; i++) {
  const line = transcriptLines[i];
  if (!line) continue;
  let entry;
  try {
    entry = JSON.parse(line);
  } catch (_e) {
    continue;
  }
  if (!entry || entry.type !== 'assistant') continue;
  const content = entry.message && entry.message.content;
  if (!Array.isArray(content)) continue;
  for (const item of content) {
    if (!item) continue;
    if (item.type === 'text' && typeof item.text === 'string') {
      lastAssistantText = item.text;
    } else if (item.type === 'tool_use') {
      turnToolUseCount++;
      if (item.name === 'Skill') {
        const name = item.input && typeof item.input.skill === 'string' ? item.input.skill : '';
        if (typeof item.id === 'string') skillsFired.push({ id: item.id, name });
      } else if (item.name === 'Bash') {
        const cmd = item.input && typeof item.input.command === 'string' ? item.input.command : '';
        if (cmd && isVerify(cmd)) {
          const result = toolResults.get(item.id);
          const output = result ? result.output : null;
          evidence.push({
            command: cmd,
            output: typeof output === 'string' && output.length > 4000 ? output.slice(-4000) : output,
            is_error: result ? result.isError : null,
            exit_code: result ? result.exitCode : null,
          });
        }
      }
    }
  }
}

const claims = CLAIM_PATTERNS.filter((r) => r.test(lastAssistantText)).map((r) => r.source);

// Monotonic per-turn identifier. Wall-clock milliseconds are unique across
// stop events within a session in practice, and sortable in a directory
// listing. A collision would just overwrite the identical-content file.
const turn = Date.now();

const payload = {
  session_id: sessionId,
  turn,
  transcript_path: transcriptPath,
  verification_commands: evidence,
  completion_claims_detected: claims,
  warning:
    claims.length > 0 && evidence.length === 0
      ? 'completion-claim without matching verification command this turn'
      : null,
};

try {
  fs.writeFileSync(
    path.join(outDir, `${sessionId}-${turn}.json`),
    `${JSON.stringify(payload, null, 2)}\n`,
  );
} catch (_e) {
  // Best-effort. Don't block the stop over a full disk.
}

// -------------------------------------------------------- firing counter
// Session-cumulative, because the signal this backs — "a core-tier skill
// never fired all session" — is a session claim, not a per-turn one. The
// evidence walk above is per-turn (bounded by the last user boundary) so
// that "no verification this turn" is a per-turn assertion; the firing
// counter has to accumulate to answer the session question, so it appends
// this turn's skillsFired to whatever the file already carried.
const firingFile = path.join(outDir, `${sessionId}-firing.json`);
let firing = { session_id: sessionId, skill_tool_uses: 0, skills: [], skill_tool_use_ids: [] };
try {
  if (fs.existsSync(firingFile)) {
    const parsed = JSON.parse(fs.readFileSync(firingFile, 'utf8'));
    if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) firing = parsed;
  }
} catch (_e) {
  // Reset silently if the prior file was corrupted.
}
const priorSkills = Array.isArray(firing.skills) ? firing.skills : [];
const priorIds = Array.isArray(firing.skill_tool_use_ids) ? firing.skill_tool_use_ids : [];
const seenIds = new Set(priorIds);
const newUses = skillsFired.filter((use) => !seenIds.has(use.id));
for (const use of newUses) seenIds.add(use.id);
firing.skills = priorSkills.concat(newUses.map((use) => use.name));
firing.skill_tool_use_ids = priorIds.concat(newUses.map((use) => use.id));
firing.skill_tool_uses = firing.skill_tool_use_ids.length;
firing.last_updated = new Date().toISOString();
try {
  fs.writeFileSync(firingFile, `${JSON.stringify(firing, null, 2)}\n`);
} catch (_e) {}

// The signal, printed to stderr so it is not swallowed by the Stop-hook
// output contract (stdout is reserved for the decision JSON — see
// claude-judge-continuation). Warning-only; the stop is never blocked.
if (payload.warning) {
  process.stderr.write(`moe-completion-evidence: ${payload.warning}\n`);
}

// ------------------------------------------------- governance spend counter
// When MOE_CURRENT_PLAN and MOE_CURRENT_TASK are set, increment the
// governance sidecar's spend counters for the active task. Advisory only —
// the sidecar is optional and a write failure is swallowed.
{
  const currentPlan = process.env.MOE_CURRENT_PLAN;
  const currentTask = process.env.MOE_CURRENT_TASK;
  if (currentPlan && currentTask) {
    const sidecarFile = currentPlan + '.governance.json';
    try {
      if (fs.existsSync(sidecarFile)) {
        const raw = JSON.parse(fs.readFileSync(sidecarFile, 'utf8'));
        if (raw && typeof raw === 'object' && !Array.isArray(raw)) {
          if (!raw.spend || typeof raw.spend !== 'object') raw.spend = {};
          const key = String(currentTask);
          const prior = raw.spend[key] && typeof raw.spend[key] === 'object' ? raw.spend[key] : {};
          raw.spend[key] = {
            toolCalls: (typeof prior.toolCalls === 'number' ? prior.toolCalls : 0) + turnToolUseCount,
            tokenEstimate: typeof prior.tokenEstimate === 'number' ? prior.tokenEstimate : 0,
            lastUpdatedAt: new Date().toISOString(),
          };
          fs.writeFileSync(sidecarFile, JSON.stringify(raw, null, 2) + '\n');
        }
      }
    } catch (_e) {
      // Best-effort. Never block the stop over a governance write failure.
    }
  }
}

process.exit(0);
