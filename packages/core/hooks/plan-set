#!/usr/bin/env node
// plan-set: the deterministic scheduler behind the `sequencing-plans` skill.
//
// A single project can grow past what one plan holds. `writing-plans` says so
// ("suggest breaking this into separate plans - one per subsystem"), and
// `brainstorming` before it ("decompose into sub-projects: what are the
// independent pieces, how do they relate, what order should they be built?").
// Neither writes that decomposition to a file, and once decomposed nothing in
// this fork tracks which plan runs after which. On a context reset the agent
// re-derives the order from prose, which is the failure mode
// `subagent-driven-development` calls "the single most expensive failure
// observed" one level down inside a plan and does not catch one level up.
//
// This CLI answers "which plan is runnable now" from a committed manifest, so a
// fresh session on a partly-finished project reads the answer instead of
// guessing. Manifest lives at `docs/moe/plans/<project>-MANIFEST.md`, one entry
// per plan, YAML in a fenced code block.
//
// With no --manifest, every manifest under docs/moe/plans participates in a
// second DAG. Output is qualified as <plan-set-id>/<plan-id> when more than one
// manifest exists. With --manifest, only that set and its prerequisite closure
// are loaded, and output remains the legacy bare plan id.
//
// This file lives under `packages/core/hooks/` rather than
// `skills/sequencing-plans/scripts/` because SessionStart invokes the adjacent
// notice before any skill body is loaded. Keeping both runtime pieces together
// also gives every generated harness the same stable plugin-relative path.
//
// Only Node built-ins. The CLI ships as a plugin hook and cannot assume the
// user has run `pnpm install` inside their project.

import { existsSync, readdirSync, readFileSync, writeFileSync } from "node:fs";
import { basename, dirname, isAbsolute, join, resolve } from "node:path";

const USAGE = `plan-set: sequence a set of plans in one project.

Usage:
  plan-set next             [--manifest <path>]
  plan-set done <id> <base>..<head> [--manifest <path>]
  plan-set check            [--manifest <path>]

If --manifest is omitted, plan-set loads every file matching
docs/moe/plans/*-MANIFEST.md under the current directory. Multi-manifest plan
references are qualified as <plan-set-id>/<plan-id>.`;

// -----------------------------------------------------------------------------
// Small argv parser: --manifest <path> optional, positional args after.

function parseArgs(argv) {
  const args = { manifest: null, positional: [] };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--manifest") {
      args.manifest = argv[++i];
      if (!args.manifest) die(`--manifest needs a path`);
    } else if (a === "--help" || a === "-h") {
      process.stdout.write(USAGE + "\n");
      process.exit(0);
    } else {
      args.positional.push(a);
    }
  }
  return args;
}

function die(msg, code = 2) {
  process.stderr.write(`plan-set: ${msg}\n`);
  process.exit(code);
}

// -----------------------------------------------------------------------------
// Manifest discovery and parse.
//
// The .md wrapper is a courtesy for humans: the file is prose plus one YAML
// fenced block, and the block is what plan-set reads. Only one fenced block
// with the language tag `yaml` is allowed, and the shape it must hold is small
// enough to parse without a dependency: optional top-level `plan_set_id` and
// `depends_on_plan_sets`, then a `plans:` list whose entries carry `id`, `plan`,
// `depends_on`, `status`, and optionally `commits`.

function manifestCandidates(dir) {
  if (!existsSync(dir)) return [];
  return readdirSync(dir)
    .filter((f) => f.endsWith("-MANIFEST.md"))
    .sort()
    .map((f) => resolve(dir, f));
}

function locateManifests(explicit) {
  if (explicit) {
    if (!existsSync(explicit)) die(`manifest not found: ${explicit}`);
    return { scoped: true, targetPath: resolve(explicit) };
  }
  const dir = join(process.cwd(), "docs", "moe", "plans");
  const candidates = manifestCandidates(dir);
  if (candidates.length === 0) {
    die(
      `no manifest found. Expected at least one docs/moe/plans/*-MANIFEST.md ` +
        `under ${process.cwd()}, or pass --manifest.`,
    );
  }
  return { scoped: false, paths: candidates };
}

function extractYaml(text, manifestPath) {
  const rx = /```yaml\r?\n([\s\S]*?)\r?\n```/g;
  const blocks = [...text.matchAll(rx)];
  if (blocks.length === 0) {
    die(`${manifestPath}: no \`\`\`yaml fenced block found`);
  }
  if (blocks.length > 1) {
    die(`${manifestPath}: more than one \`\`\`yaml fenced block; keep the manifest in exactly one`);
  }
  return blocks[0][1];
}

// Minimal YAML parser for the manifest shape only.
//
// Accepts optional plan-set metadata followed by `plans:`, whose value is a
// list of maps. Each map key must be one of id/plan/depends_on/status/commits,
// indented two spaces past the `-`. Dependencies are flow lists.
//
// A generic YAML parser would work — bringing one in as a dep for a hook that
// ships in a plugin does not. This parser fails loudly on anything it does not
// recognise so a malformed manifest does not silently degrade to "no plans".
function parseManifestYaml(body, manifestPath) {
  const lines = body.split(/\r?\n/);
  const doc = {
    plan_set_id: null,
    depends_on_plan_sets: [],
    has_plan_set_id: false,
    has_depends_on_plan_sets: false,
    plans: [],
  };
  let i = 0;
  // Skip leading blanks and comments.
  while (i < lines.length && /^\s*(#|$)/.test(lines[i])) i++;
  for (; i < lines.length && !/^plans:\s*$/.test(lines[i]); i++) {
    const line = lines[i];
    if (/^\s*(#|$)/.test(line)) continue;
    const m = /^([a-z_]+):\s*(.*)$/.exec(line);
    if (!m) die(`${manifestPath}:${i + 1}: unrecognised top-level line: ${line}`);
    if (m[1] === "plan_set_id") {
      doc.plan_set_id = stripQuotes(m[2].trim());
      doc.has_plan_set_id = true;
    } else if (m[1] === "depends_on_plan_sets") {
      doc.depends_on_plan_sets = parseFlowList(
        m[2].trim(),
        manifestPath,
        i + 1,
        "depends_on_plan_sets",
      );
      doc.has_depends_on_plan_sets = true;
    } else {
      die(`${manifestPath}:${i + 1}: unknown top-level key "${m[1]}"`);
    }
  }
  if (i >= lines.length) {
    die(`${manifestPath}: expected top-level "plans:" key in yaml block`);
  }
  i++;
  let current = null;
  const push = () => {
    if (current !== null) doc.plans.push(current);
    current = null;
  };
  for (; i < lines.length; i++) {
    const line = lines[i];
    if (/^\s*(#|$)/.test(line)) continue;
    // New list item: `  - id: foo` OR `  -`
    let m = /^\s{2}-\s+([a-z_]+):\s*(.*)$/.exec(line);
    if (m) {
      push();
      current = { id: null, plan: null, depends_on: [], status: null, commits: null };
      applyKV(current, m[1], m[2], manifestPath, i + 1);
      continue;
    }
    // Continuation: `    key: value`
    m = /^\s{4}([a-z_]+):\s*(.*)$/.exec(line);
    if (m) {
      if (!current) die(`${manifestPath}:${i + 1}: continuation before a list item`);
      applyKV(current, m[1], m[2], manifestPath, i + 1);
      continue;
    }
    die(`${manifestPath}:${i + 1}: unrecognised line: ${line}`);
  }
  push();
  return doc;
}

function applyKV(entry, key, rawValue, path, lineNo) {
  const value = rawValue.trim();
  const allowed = ["id", "plan", "depends_on", "status", "commits"];
  if (!allowed.includes(key)) die(`${path}:${lineNo}: unknown key "${key}"`);
  if (key === "depends_on") {
    entry.depends_on = parseFlowList(value, path, lineNo);
  } else {
    entry[key] = value === "" ? null : stripQuotes(value);
  }
}

function stripQuotes(v) {
  if ((v.startsWith('"') && v.endsWith('"')) || (v.startsWith("'") && v.endsWith("'"))) {
    return v.slice(1, -1);
  }
  return v;
}

function parseFlowList(v, path, lineNo, field = "depends_on") {
  if (!v.startsWith("[") || !v.endsWith("]")) {
    die(`${path}:${lineNo}: ${field} must be a flow list like [] or [a, b]`);
  }
  const inner = v.slice(1, -1).trim();
  if (inner === "") return [];
  return inner.split(",").map((s) => stripQuotes(s.trim()));
}

function derivedSetId(manifestPath) {
  return basename(manifestPath).replace(/-MANIFEST\.md$/, "");
}

function parseManifest(manifestPath) {
  const rawText = readFileSync(manifestPath, "utf8");
  const body = extractYaml(rawText, manifestPath);
  const doc = parseManifestYaml(body, manifestPath);
  return {
    path: manifestPath,
    rawText,
    doc,
    setId: doc.plan_set_id || derivedSetId(manifestPath),
  };
}

// Read only enough metadata to index siblings for a scoped prerequisite walk.
// A malformed, unrelated sibling must not poison `--manifest foo`.
function peekSetId(manifestPath) {
  const rawText = readFileSync(manifestPath, "utf8");
  const block = /```yaml\r?\n([\s\S]*?)\r?\n```/.exec(rawText)?.[1] ?? "";
  const match = /^plan_set_id:\s*(.*?)\s*$/m.exec(block);
  return match?.[1] ? stripQuotes(match[1]) : derivedSetId(manifestPath);
}

function loadManifestSet(located) {
  if (!located.scoped) {
    return {
      scoped: false,
      target: null,
      records: located.paths.map(parseManifest),
    };
  }

  const target = parseManifest(located.targetPath);
  const candidates = manifestCandidates(dirname(located.targetPath));
  const byId = new Map();
  for (const path of candidates) {
    const id = peekSetId(path);
    const list = byId.get(id) ?? [];
    list.push(path);
    byId.set(id, list);
  }

  const selected = new Map([[target.setId, target]]);
  const queue = [...target.doc.depends_on_plan_sets];
  while (queue.length > 0) {
    const id = queue.shift();
    if (selected.has(id)) continue;
    const matches = byId.get(id) ?? [];
    if (matches.length === 0) die(`${target.setId}: depends_on_plan_sets "${id}" — not a known plan-set id`);
    if (matches.length > 1) die(`duplicate plan_set_id "${id}" in scoped prerequisite closure`);
    const record = parseManifest(matches[0]);
    selected.set(id, record);
    queue.push(...record.doc.depends_on_plan_sets);
  }
  return {
    scoped: true,
    target,
    records: [...selected.values()].sort((a, b) => a.path.localeCompare(b.path)),
  };
}

// -----------------------------------------------------------------------------
// Manifest validation shared by `check` and every other verb.
//
// A validation failure that shows up under `next` but not `check` would be a
// second, invisible spec; run the same walk both times and report every
// failure at once rather than the first.

const VALID_STATUS = new Set(["pending", "running", "done", "blocked"]);
const VALID_PLAN_SET_ID = /^[A-Za-z0-9][A-Za-z0-9._-]*$/;

function validate(doc, manifestPath) {
  const errors = [];
  const ids = new Map(); // id -> line-ish
  const planPaths = new Map(); // plan -> id
  const manifestDir = dirname(manifestPath);

  for (const [i, p] of doc.plans.entries()) {
    const at = `entry ${i + 1}`;
    if (!p.id) errors.push(`${at}: missing "id"`);
    if (!p.plan) errors.push(`${at}: missing "plan"`);
    if (!p.status) errors.push(`${at}: missing "status"`);
    if (p.status && !VALID_STATUS.has(p.status)) {
      errors.push(
        `${at} (${p.id ?? "?"}): status "${p.status}" is not one of ` +
          `${[...VALID_STATUS].join("/")}`,
      );
    }
    if (p.id) {
      if (ids.has(p.id)) errors.push(`duplicate id "${p.id}" (also at ${ids.get(p.id)})`);
      else ids.set(p.id, at);
    }
    if (p.plan) {
      if (planPaths.has(p.plan)) {
        errors.push(`plan file "${p.plan}" listed by both ${planPaths.get(p.plan)} and ${p.id}`);
      } else planPaths.set(p.plan, p.id ?? at);
      const absPlan = isAbsolute(p.plan) ? p.plan : resolve(manifestDir, "..", "..", "..", p.plan);
      // A path is what the manifest lists. Try three anchors, in order:
      //   1. relative to CWD, for `plan: docs/moe/plans/X.md` when the CLI is
      //      run from the repo root.
      //   2. relative to the manifest's grandparent's parent, for the same
      //      shape when the CLI is run from anywhere under the repo (a
      //      manifest under docs/moe/plans/ implies a repo root three levels
      //      up).
      //   3. relative to the manifest itself, for fixtures and standalone
      //      test manifests that keep plans in a sibling directory.
      const candidates = [
        resolve(process.cwd(), p.plan),
        absPlan,
        resolve(manifestDir, p.plan),
        resolve(manifestDir, basename(p.plan)),
      ];
      if (!candidates.some((c) => existsSync(c))) {
        errors.push(`${at} (${p.id ?? "?"}): plan file not found — ${p.plan}`);
      }
    }
  }

  // Dep resolution and cycle detection (Kahn's algorithm).
  const known = new Set(ids.keys());
  const indeg = new Map();
  const adj = new Map(); // dep -> [dependents]
  for (const id of known) {
    indeg.set(id, 0);
    adj.set(id, []);
  }
  for (const p of doc.plans) {
    if (!p.id) continue;
    for (const d of p.depends_on) {
      if (!known.has(d)) {
        errors.push(`${p.id}: depends_on "${d}" — not a known id`);
        continue;
      }
      indeg.set(p.id, (indeg.get(p.id) ?? 0) + 1);
      adj.get(d).push(p.id);
    }
  }

  // Kahn: pull zero-indegree nodes off, decrement neighbors. Anything left
  // with indegree > 0 is on a cycle.
  const q = [];
  const remaining = new Map(indeg);
  for (const [id, deg] of remaining) if (deg === 0) q.push(id);
  let seen = 0;
  while (q.length) {
    const id = q.shift();
    seen++;
    for (const n of adj.get(id) ?? []) {
      remaining.set(n, remaining.get(n) - 1);
      if (remaining.get(n) === 0) q.push(n);
    }
  }
  const inCycle = [...remaining.entries()].filter(([, d]) => d > 0).map(([id]) => id);
  if (inCycle.length > 0) {
    errors.push(`cycle detected among: ${inCycle.sort().join(", ")}`);
  }

  return { errors, indeg: new Map(indeg), adj, ids: known };
}

function canonicalPlanPath(plan, manifestPath) {
  const manifestDir = dirname(manifestPath);
  const candidates = isAbsolute(plan)
    ? [plan]
    : [
        resolve(process.cwd(), plan),
        resolve(manifestDir, "..", "..", "..", plan),
        resolve(manifestDir, plan),
        resolve(manifestDir, basename(plan)),
      ];
  return candidates.find((candidate) => existsSync(candidate)) ?? candidates[0];
}

function validateManifestSet(records) {
  const errors = [];
  for (const record of records) errors.push(...validate(record.doc, record.path).errors);

  const setById = new Map();
  const setLocations = new Map();
  const planPaths = new Map();
  for (const record of records) {
    if (record.doc.has_plan_set_id && !record.doc.plan_set_id) {
      errors.push(`${record.path}: plan_set_id must not be empty`);
    } else if (!VALID_PLAN_SET_ID.test(record.setId)) {
      errors.push(
        `plan_set_id "${record.setId}" must match [A-Za-z0-9][A-Za-z0-9._-]*`,
      );
    }
    if (record.doc.plans.length === 0) {
      errors.push(`plan set "${record.setId}" must contain at least one plan`);
    }
    if (setById.has(record.setId)) {
      errors.push(
        `duplicate plan_set_id "${record.setId}" (${setLocations.get(record.setId)} and ${record.path})`,
      );
    } else {
      setById.set(record.setId, record);
      setLocations.set(record.setId, record.path);
    }
    for (const plan of record.doc.plans) {
      if (!plan.plan || !plan.id) continue;
      const canonical = canonicalPlanPath(plan.plan, record.path);
      const owner = `${record.setId}/${plan.id}`;
      if (planPaths.has(canonical)) {
        errors.push(`plan file "${plan.plan}" listed by both ${planPaths.get(canonical)} and ${owner}`);
      } else {
        planPaths.set(canonical, owner);
      }
    }
  }

  const indeg = new Map();
  const adj = new Map();
  for (const id of setById.keys()) {
    indeg.set(id, 0);
    adj.set(id, []);
  }
  for (const record of records) {
    for (const dependency of record.doc.depends_on_plan_sets) {
      if (!setById.has(dependency)) {
        errors.push(
          `${record.setId}: depends_on_plan_sets "${dependency}" — not a known plan-set id`,
        );
        continue;
      }
      indeg.set(record.setId, (indeg.get(record.setId) ?? 0) + 1);
      adj.get(dependency)?.push(record.setId);
    }
  }

  const remaining = new Map(indeg);
  const queue = [...remaining.entries()].filter(([, degree]) => degree === 0).map(([id]) => id);
  while (queue.length > 0) {
    const id = queue.shift();
    for (const dependent of adj.get(id) ?? []) {
      remaining.set(dependent, remaining.get(dependent) - 1);
      if (remaining.get(dependent) === 0) queue.push(dependent);
    }
  }
  const inCycle = [...remaining.entries()]
    .filter(([, degree]) => degree > 0)
    .map(([id]) => id)
    .sort();
  if (inCycle.length > 0) errors.push(`plan-set cycle detected among: ${inCycle.join(", ")}`);

  const completedSets = new Set();
  const blockedSets = new Set();
  for (const record of records) {
    if (record.doc.plans.length > 0 && record.doc.plans.every((plan) => plan.status === "done")) {
      completedSets.add(record.setId);
    }
    if (record.doc.plans.some((plan) => plan.status === "blocked")) blockedSets.add(record.setId);
  }
  const blockedQueue = [...blockedSets];
  while (blockedQueue.length > 0) {
    const id = blockedQueue.shift();
    for (const dependent of adj.get(id) ?? []) {
      if (blockedSets.has(dependent)) continue;
      blockedSets.add(dependent);
      blockedQueue.push(dependent);
    }
  }

  return { errors, setById, completedSets, blockedSets };
}

// -----------------------------------------------------------------------------
// Verbs.

function printErrorsAndExit(errors) {
  if (errors.length > 0) {
    for (const e of errors) process.stderr.write(`plan-set: ${e}\n`);
    process.exit(1);
  }
}

function verbCheck(loaded) {
  const { errors } = validateManifestSet(loaded.records);
  printErrorsAndExit(errors);
  const planCount = loaded.records.reduce((count, record) => count + record.doc.plans.length, 0);
  if (loaded.scoped && loaded.records.length === 1) {
    process.stdout.write(`plan-set: ${loaded.target.path} ok — ${planCount} plans\n`);
  } else {
    process.stdout.write(
      `plan-set: ${loaded.records.length} manifests ok — ${planCount} plans\n`,
    );
  }
}

function statusOf(doc) {
  const m = new Map();
  for (const p of doc.plans) if (p.id) m.set(p.id, p.status);
  return m;
}

// Transitive block set: every id reachable from a `blocked` node in the
// dependency direction (dependents), plus the blocked nodes themselves. A
// plan whose foundation is blocked is not ready no matter what its own status
// says — moe-core #2830 is the failure this exists to preclude.
function blockedClosure(doc) {
  const status = statusOf(doc);
  const adj = new Map(); // dep -> dependents
  for (const p of doc.plans) if (p.id) adj.set(p.id, []);
  for (const p of doc.plans) {
    if (!p.id) continue;
    for (const d of p.depends_on) {
      if (adj.has(d)) adj.get(d).push(p.id);
    }
  }
  const closure = new Set();
  const stack = [];
  for (const [id, s] of status) if (s === "blocked") stack.push(id);
  while (stack.length) {
    const id = stack.pop();
    if (closure.has(id)) continue;
    closure.add(id);
    for (const n of adj.get(id) ?? []) if (!closure.has(n)) stack.push(n);
  }
  return closure;
}

function readyPlans(doc) {
  const status = statusOf(doc);
  const blocked = blockedClosure(doc);
  return doc.plans
    .filter((plan) => {
      if (!plan.id || blocked.has(plan.id) || plan.status !== "pending") return false;
      return plan.depends_on.every((dependency) => status.get(dependency) === "done");
    })
    .map((plan) => plan.id);
}

function prerequisitesComplete(record, completedSets) {
  return record.doc.depends_on_plan_sets.every((dependency) => completedSets.has(dependency));
}

function verbNext(loaded, state) {
  const records = loaded.scoped ? [loaded.target] : loaded.records;
  const qualified = !loaded.scoped && loaded.records.length > 1;
  for (const record of records) {
    if (!prerequisitesComplete(record, state.completedSets)) continue;
    for (const id of readyPlans(record.doc)) {
      process.stdout.write((qualified ? `${record.setId}/${id}` : id) + "\n");
    }
  }
}

function selectDoneTarget(loaded, reference) {
  if (loaded.scoped) {
    const prefix = `${loaded.target.setId}/`;
    return {
      record: loaded.target,
      id: reference?.startsWith(prefix) ? reference.slice(prefix.length) : reference,
      display: reference,
    };
  }
  if (loaded.records.length === 1) {
    return { record: loaded.records[0], id: reference, display: reference };
  }
  const slash = reference?.indexOf("/") ?? -1;
  if (slash <= 0 || slash === reference.length - 1) {
    die(`done: multi-manifest plan id must be qualified as <plan-set-id>/<plan-id>`);
  }
  const setId = reference.slice(0, slash);
  const id = reference.slice(slash + 1);
  const record = loaded.records.find((candidate) => candidate.setId === setId);
  if (!record) die(`done: unknown plan-set id "${setId}"`);
  return { record, id, display: reference };
}

function verbDone(loaded, state, reference, range) {
  const { record, id, display } = selectDoneTarget(loaded, reference);
  if (!id) die(`done: usage: plan-set done <id> <base>..<head>`);
  if (!range) die(`done: usage: plan-set done <id> <base>..<head>`);
  if (!/^[0-9a-f]{7,40}\.\.[0-9a-f]{7,40}$/.test(range)) {
    die(`done: range "${range}" is not two 7+-char hex SHAs joined by ".."`);
  }
  for (const dependency of record.doc.depends_on_plan_sets) {
    if (!state.completedSets.has(dependency)) {
      const condition = state.blockedSets.has(dependency) ? "blocked" : "incomplete";
      die(
        `done: cannot mark ${display} done — prerequisite plan set "${dependency}" is ${condition}`,
      );
    }
  }
  const status = statusOf(record.doc);
  if (!status.has(id)) die(`done: unknown id "${id}"`);
  const entry = record.doc.plans.find((p) => p.id === id);
  if (blockedClosure(record.doc).has(id)) {
    die(`done: cannot mark ${display} done — plan is blocked by its local dependency graph`);
  }
  for (const d of entry.depends_on) {
    if (status.get(d) !== "done") {
      die(`done: cannot mark ${id} done — dep "${d}" is ${status.get(d) ?? "unknown"}`);
    }
  }
  // Rewrite the manifest in place. Preserve everything outside the yaml block;
  // the block itself is regenerated from the parsed model so hand-formatting
  // may not survive but the semantics do.
  entry.status = "done";
  entry.commits = range;
  const newBlock = renderYaml(record.doc);
  const newText = record.rawText.replace(
    /```yaml\r?\n([\s\S]*?)\r?\n```/,
    "```yaml\n" + newBlock + "```",
  );
  writeFileSync(record.path, newText);
  process.stdout.write(`plan-set: marked ${display} done (${range})\n`);
}

function renderYaml(doc) {
  const lines = [];
  if (doc.has_plan_set_id) lines.push(`plan_set_id: ${doc.plan_set_id}`);
  if (doc.has_depends_on_plan_sets) {
    lines.push(`depends_on_plan_sets: [${doc.depends_on_plan_sets.join(", ")}]`);
  }
  lines.push("plans:");
  for (const p of doc.plans) {
    lines.push(`  - id: ${p.id}`);
    lines.push(`    plan: ${p.plan}`);
    lines.push(`    depends_on: [${(p.depends_on ?? []).join(", ")}]`);
    lines.push(`    status: ${p.status}`);
    if (p.commits) lines.push(`    commits: ${p.commits}`);
  }
  return lines.join("\n") + "\n";
}

// -----------------------------------------------------------------------------
// main.

function main() {
  const argv = process.argv.slice(2);
  if (argv.length === 0 || argv[0] === "--help" || argv[0] === "-h") {
    process.stdout.write(USAGE + "\n");
    process.exit(argv.length === 0 ? 2 : 0);
  }
  const verb = argv[0];
  const rest = parseArgs(argv.slice(1));
  const loaded = loadManifestSet(locateManifests(rest.manifest));

  if (verb === "check") {
    verbCheck(loaded);
    return;
  }

  // next and done require a valid manifest; a cycle in the graph would give
  // both wrong answers, so run validate first.
  const state = validateManifestSet(loaded.records);
  printErrorsAndExit(state.errors);

  if (verb === "next") {
    verbNext(loaded, state);
    return;
  }
  if (verb === "done") {
    verbDone(loaded, state, rest.positional[0], rest.positional[1]);
    return;
  }
  die(`unknown verb "${verb}"\n${USAGE}`);
}

// Only file, only entry point. If this raises, node prints the stack and exits
// non-zero, which is what a hook wrapper wants.
main();
