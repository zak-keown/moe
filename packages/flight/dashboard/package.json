{
  "name": "@tc/moe-flight-dashboard",
  "version": "0.0.0-tc.1",
  "private": true,
  "type": "module",
  "description": "Read-only scenario x agent x credential x OS results grid for moe-flight, server-rendered and live-updated over SSE.",
  "license": "Apache-2.0",
  "moeRelease": {
    "upstreamVersion": "0.0.0",
    "upstreamCommit": "54b4ec6c54540d472835c1e074e7e7c8e6469329"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "moe-flight-dashboard": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -b && node scripts/copy-static.mjs",
    "typecheck": "tsc -b --pretty && tsc -p tsconfig.tests.json --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check ."
  },
  "dependencies": {
    "@hono/node-server": "^2.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
