{
  "name": "@bubstack/moe-memory",
  "version": "0.1.4",
  "type": "module",
  "description": "Semantic recall over past sessions and journal entries.",
  "license": "MIT",
  "author": {
    "name": "Zak Keown",
    "email": "zak.keown@outlook.com"
  },
  "homepage": "https://github.com/zak-keown/moe",
  "repository": "https://github.com/zak-keown/moe",
  "keywords": [
    "memory",
    "search",
    "embeddings",
    "journal",
    "mcp"
  ],
  "engines": {
    "node": ">=24"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "moe-memory": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "vendor",
    "agents",
    "hooks",
    "prompts",
    "skills",
    ".mcp.json"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -b --force",
    "prepack": "pnpm run build",
    "typecheck": "tsc -b --pretty && tsc -p tsconfig.tests.json --pretty",
    "test": "vitest run --project unit",
    "test:model": "vitest run --project model",
    "test:claude-e2e": "node test/manual/claude-e2e.js",
    "test:codex-e2e": "node test/manual/codex-e2e.js",
    "lint": "biome check ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.126",
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "marked": "^16.4.0",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
