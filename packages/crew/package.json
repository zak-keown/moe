{
  "name": "@bubstack/moe-crew",
  "version": "0.1.0",
  "type": "module",
  "description": "Launch, control and monitor worker coding-agent sessions (Claude Code, Codex, Pi) over tmux.",
  "license": "MIT",
  "author": {
    "name": "Zak Keown",
    "email": "zak.keown@outlook.com"
  },
  "homepage": "https://gitlab.com/moe-ai/moe",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/moe-ai/moe.git"
  },
  "keywords": [
    "claude-code",
    "codex",
    "cursor",
    "kimi",
    "opencode",
    "pi",
    "copilot",
    "tmux",
    "orchestration",
    "subagents",
    "sessions"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "hooks",
    "skills",
    "docs",
    "README.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "moe-crew": "./dist/moe-crew.cjs"
  },
  "scripts": {
    "build": "tsc -b && tsup",
    "prepack": "pnpm run build",
    "typecheck": "tsc -b --pretty && tsc -p tsconfig.tests.json --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.74.0",
    "@types/node": "^24.7.0",
    "smol-toml": "^1.6.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
