{
  "name": "@tc/moe-tab",
  "version": "0.0.0-tc.1",
  "type": "module",
  "description": "TypeScript binding for the moe-tab transcript pricer over its C ABI (Bun + Node).",
  "license": "Apache-2.0",
  "moeRelease": {
    "upstreamVersion": "0.0.0",
    "upstreamCommit": "54b4ec6c54540d472835c1e074e7e7c8e6469329"
  },
  "publishConfig": {
    "registry": "https://proget.tcdevops.com/npm/tcnpm/"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "native",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty && tsc -p tsconfig.tests.json --pretty",
    "test": "vitest run --project unit",
    "test:ffi": "vitest run --project ffi",
    "lint": "biome check ."
  },
  "dependencies": {
    "koffi": "2.16.2"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
