{
  "name": "@tc/moe-glass",
  "version": "0.0.0-tc.1",
  "type": "module",
  "description": "Direct Chrome DevTools Protocol access. Skill mode (17 CLI commands) plus MCP mode (single use_browser tool). Auto-starts Chrome.",
  "license": "MIT",
  "moeRelease": {
    "upstreamVersion": "0.0.0",
    "upstreamCommit": "54b4ec6c54540d472835c1e074e7e7c8e6469329"
  },
  "publishConfig": {
    "registry": "https://proget.tcdevops.com/npm/tcnpm/"
  },
  "main": "dist/index.js",
  "bin": {
    "moe-glass": "./dist/index.js"
  },
  "files": [
    "dist",
    "agents",
    "skills"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:fsevents && node ../../scripts/copy-license.mjs MIT dist/LICENSE",
    "prepack": "pnpm run build",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run --project unit",
    "test:chrome": "vitest run --project chrome",
    "lint": "biome check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "esbuild": "^0.25.11",
    "jsdom": "^29.0.2",
    "typescript": "^5.9.0"
  }
}
