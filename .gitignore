# Upstream reference snapshots: 19 nested git repos, pinned in PARITY.md.
# Never tracked here — they are the parity spec, not our source.
../.moe-references/

node_modules/
dist/
build/
target/
.turbo/
*.tsbuildinfo

# Python (py/proof)
__pycache__/
.venv/
*.egg-info/

# NOTE: /plugins/ is GENERATED but deliberately TRACKED. It used to be ignored
# here, which could not work: `.claude-plugin/marketplace.json` sources each
# plugin as `./plugins/<name>`, so a marketplace consumer cloning this repo would
# find every plugin a broken link. It is regenerated by `pnpm mint` and CI
# asserts it is byte-identical with `pnpm mint:check`, which is what stops a
# hand-edited manifest from drifting. Never hand-edit it; edit
# `packages/<pkg>/mint/<plugin>.yaml` and regenerate.

.DS_Store
*.log
.env
.env.*

# Claude Code session state, including live workflow git worktrees. Never tracked:
# `git add -A` while a workflow is running would otherwise stage them as embedded repos.
.claude/

# Build artifacts from packages/tab's release and binding scripts. Root covers
# target/, dist/, __pycache__ and *.egg-info; these seven it does not.
packages/tab/bindings/typescript/native/
packages/tab/wheelhouse/
packages/tab/.pricing/
packages/tab/bindings/python/moe_tab/libmoe_tab_ffi.*
packages/tab/bindings/python/uv.lock
packages/tab/bindings/go/tab/total
packages/tab/bindings/go/cmd/total/total
.pytest_cache/

# Output of `moe-proof run`. Path-scoped deliberately: a bare `runs/` would hide
# legitimate directories elsewhere in the monorepo.
py/proof/examples/*/runs/

# pnpm content-addressable store — created locally when the store path is
# resolved inside the repo (a pnpm 11 default on some setups). Never source.
.pnpm-store/

# Interrupted Mint generation state. These are the only nonce-bearing siblings
# the swap protocol owns; do not broaden these patterns to arbitrary siblings.
/plugins.next-*
/plugins.backup-*
/.claude-plugin/marketplace.next-*.json
/.claude-plugin/marketplace.backup-*.json
/docs/moe/generated/plugin-catalog.next-*.md
/docs/moe/generated/plugin-catalog.backup-*.md
/.moe-mint-generation-*.json
/..moe-mint-generation-*.json.tmp-*
/.claude-plugin/.marketplace.next-*.json.tmp-*
/.claude-plugin/.marketplace.backup-*.json.tmp-*
/docs/moe/generated/.plugin-catalog.next-*.md.tmp-*
/docs/moe/generated/.plugin-catalog.backup-*.md.tmp-*
