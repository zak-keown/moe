{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${PLUGIN_ROOT:-}\" ]; then exit 0; fi; node \"${CLAUDE_PLUGIN_ROOT}/dist/ensure-statusline.cjs\""
          }
        ]
      }
    ]
  }
}
