{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": [],
      "cache": true
    },
    "@tc/moe-mint#test": {
      "dependsOn": ["build"],
      "outputs": [],
      "cache": false
    },
    "lint": {
      "outputs": []
    },
    "//#mint:generate": {
      "dependsOn": ["@tc/moe-mint#build"],
      "inputs": [
        "scripts/mint-plugins.mjs",
        ".claude-plugin/marketplace.json",
        "packages/core/skill-tiers.yaml",
        "packages/*/mint/*.yaml",
        "packages/*/skills/**",
        "packages/*/commands/**",
        "packages/*/agents/**",
        "packages/*/hooks/**",
        "packages/*/.mcp.json"
      ],
      "outputs": ["plugins/**"]
    }
  }
}
