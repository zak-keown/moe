#!/usr/bin/env node
// Harness-routed Moe installer. Dependency-free ESM, dry-run by default.

import { spawnSync } from "node:child_process";
import {
  getHarness,
  HARNESS_IDS,
  manualPlanForHarness,
  MARKETPLACE_NAME,
  pluginsForHarness,
  REPOSITORY_CLONE_URL,
  REPOSITORY_URL,
  selectHarness,
} from "./lib/plugin-registry.mjs";
import { allProbes, detectInstalledHarnesses, overallExit } from "./lib/probes.mjs";

const SCOPES = ["user", "project", "local"];

function usage() {
  return [
    "moe-install — install, upgrade, or uninstall Moe for one host harness.",
    "",
    "Usage:",
    "  moe-install --harness <adapter-id>              Print an install plan (dry-run).",
    "  moe-install --harness <adapter-id> --apply      Apply a supported install plan.",
    "  moe-install --upgrade|--uninstall [--apply]     Select another action.",
    "  moe-install --scope user|project|local          Claude Code automation only.",
    "  moe-install --skip-doctor                       Skip doctor before an automated install.",
    "  moe-install --help                              Show this message.",
    "",
    `Adapter IDs: ${HARNESS_IDS.join(", ")}`,
    "Selection precedence: --harness, MOE_DEFAULT_HARNESS, sole installed host executable.",
    "Agent Plugins 1.0 has no unique executable and requires explicit/default selection.",
    "The default is intentionally read-only. Nothing changes without --apply.",
    "",
  ].join("\n");
}

function parseArgs(argv) {
  let harness;
  let scope;
  let help = false;
  let apply = false;
  let skipDoctor = false;
  const actionFlags = [];

  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    if (arg === "--help" || arg === "-h") help = true;
    else if (arg === "--apply") apply = true;
    else if (arg === "--skip-doctor") skipDoctor = true;
    else if (arg === "--upgrade" || arg === "--uninstall") actionFlags.push(arg.slice(2));
    else if (arg === "--harness" || arg === "--scope") {
      const value = argv[++i];
      if (!value || value.startsWith("--")) return { error: `${arg} requires a value` };
      if (arg === "--harness") {
        if (harness !== undefined) return { error: "--harness may be provided only once" };
        harness = value;
      } else {
        if (scope !== undefined) return { error: "--scope may be provided only once" };
        scope = value;
      }
    } else if (arg.startsWith("-")) return { error: `unknown option "${arg}"` };
    else return { error: `unexpected argument "${arg}"` };
  }

  if (actionFlags.length > 1) return { error: "choose only one action: --upgrade or --uninstall" };
  if (scope !== undefined && !SCOPES.includes(scope)) {
    return { error: `invalid scope "${scope}"; expected ${SCOPES.join("|")}` };
  }
  return { help, apply, skipDoctor, action: actionFlags[0] ?? "install", harness, scope };
}

function scopeArgs(scope) {
  return scope ? ["--scope", scope] : [];
}

function automatedInstallActions(route, plugins, scope) {
  const s = scopeArgs(scope);
  const command = route === "copilot-marketplace" ? "copilot" : "claude";
  const repository = route === "copilot-marketplace" ? REPOSITORY_URL : REPOSITORY_CLONE_URL;
  return [
    [command, "plugin", "marketplace", "add", repository, ...s],
    ...plugins.map((plugin) => [command, "plugin", "install", `${plugin.name}@${MARKETPLACE_NAME}`, ...s]),
  ];
}

function printableAction(action) {
  return action.join(" ");
}

function printManualPlan(harnessId, action) {
  process.stdout.write("Manual plan (no commands will be executed):\n");
  for (const line of manualPlanForHarness(harnessId, action)) process.stdout.write(`  ${line}\n`);
}

function runDoctor(harnessId) {
  process.stdout.write(`Running moe-doctor for ${harnessId} first...\n\n`);
  const results = allProbes(harnessId);
  for (const probe of results) {
    const tag = probe.ok ? "ok" : probe.tier === "hard" ? "MISS" : "warn";
    const version = probe.version ? ` (${probe.version})` : "";
    process.stdout.write(`  [${tag}] ${probe.name}${version}\n`);
    if (!probe.ok && probe.fixHint) process.stdout.write(`         fix: ${probe.fixHint}\n`);
  }
  const status = overallExit(results);
  process.stdout.write(
    status === 0
      ? "\nDoctor passed. Proceeding with install.\n\n"
      : "\nDoctor found HARD gaps. Fix them and re-run.\n",
  );
  return status;
}

function runActions(actions) {
  for (const [command, ...args] of actions) {
    process.stdout.write(`  $ ${printableAction([command, ...args])}\n`);
    const result = spawnSync(command, args, { stdio: "inherit" });
    if (result.error) {
      process.stderr.write(`moe-install: failed to spawn ${command}: ${result.error.message}\n`);
      return 127;
    }
    const status = result.status ?? 1;
    if (status !== 0) {
      process.stderr.write(`moe-install: ${command} ${args.join(" ")} exited ${status}\n`);
      return status;
    }
  }
  return 0;
}

function argumentError(message) {
  process.stderr.write(`moe-install: ${message}\n\n${usage()}`);
  process.exit(2);
}

const parsed = parseArgs(process.argv.slice(2));
if (parsed.error) argumentError(parsed.error);
if (parsed.help) {
  process.stdout.write(usage());
  process.exit(0);
}

const selection = selectHarness({
  explicit: parsed.harness,
  configuredDefault: process.env.MOE_DEFAULT_HARNESS || undefined,
  installed: detectInstalledHarnesses(),
});
if (selection.error) argumentError(selection.error);

const harness = getHarness(selection.id);
if (parsed.scope && !harness.scopes.includes(parsed.scope)) {
  argumentError(`${selection.id} does not support --scope; omit it or select claude-code`);
}

const plugins = pluginsForHarness(selection.id);
const route = harness.automation[parsed.action];
process.stdout.write(
  `moe-install: mode=${parsed.action} harness=${selection.id} selected-by=${selection.source}${parsed.scope ? ` scope=${parsed.scope}` : ""}\n\n`,
);

if (!route) {
  printManualPlan(selection.id, parsed.action);
  if (parsed.apply) {
    process.stderr.write(
      `\nmoe-install: ${selection.id} ${parsed.action} is manual-only; no stable automated route is verified, so --apply made no changes.\n`,
    );
    process.exit(2);
  }
  process.exit(0);
}

const actions = automatedInstallActions(route, plugins, parsed.scope);
if (!parsed.apply) {
  process.stdout.write("Plan (dry-run — re-run with --apply to execute):\n");
  for (const action of actions) process.stdout.write(`  ${printableAction(action)}\n`);
  process.exit(0);
}

if (parsed.action === "install" && !parsed.skipDoctor) {
  const doctorStatus = runDoctor(selection.id);
  if (doctorStatus !== 0) process.exit(doctorStatus);
}

process.exit(runActions(actions));
