#!/usr/bin/env node
// moe-install — persist the TC umbrella CLI and manage its Claude plugins.
// Dependency-free ESM for macOS, Linux and WSL2. Native Windows is deferred.

import { spawnSync } from "node:child_process";
import { readFileSync, realpathSync } from "node:fs";
import { fileURLToPath } from "node:url";
import {
  MARKETPLACE,
  NPM_CLI_PACKAGES,
  UMBRELLA_PACKAGE,
} from "../config/distribution.mjs";
import { allProbes, overallExit } from "./lib/probes.mjs";

export function usage() {
  return [
    "moe-install — install, upgrade, or uninstall Moe.",
    "",
    "Usage:",
    "  moe-install                    Print the install plan and exit (dry-run).",
    "  moe-install --apply            Persist this exact TC release and install every plugin.",
    "  moe-install --upgrade          Print the upgrade plan; add --apply to execute it.",
    "  moe-install --uninstall        Print the uninstall plan; add --apply to execute it.",
    "  moe-install --skip-doctor      Skip the doctor probe on install (not recommended).",
    "  moe-install --scope <s>        Pass --scope user|project|local to plugin operations.",
    "  moe-install --help             Show this message.",
    "",
    "The default is intentionally read-only. Nothing changes without --apply.",
    "`moe install|upgrade|uninstall` injects --apply for the normal lifecycle.",
    "",
  ].join("\n");
}

export function parseArgs(argv) {
  const flags = new Set();
  let scope;
  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    if (arg === "--scope") {
      scope = argv[++i];
      continue;
    }
    if (arg.startsWith("--") || arg === "-h") flags.add(arg);
  }
  return { flags, scope };
}

function packageVersion() {
  const packageJson = JSON.parse(
    readFileSync(fileURLToPath(new URL("../package.json", import.meta.url)), "utf8"),
  );
  if (typeof packageJson.version !== "string" || packageJson.version.length === 0) {
    throw new Error("the @tc/moe package has no version");
  }
  return packageJson.version;
}

function run(cmd, args, { dryRun, stdout, stderr, spawn = spawnSync, env = process.env }) {
  const printable = [cmd, ...args].join(" ");
  if (dryRun) {
    stdout.write(`  [dry-run] ${printable}\n`);
    return 0;
  }
  stdout.write(`  $ ${printable}\n`);
  const result = spawn(cmd, args, { stdio: "inherit", env });
  if (result.error) {
    stderr.write(`moe-install: failed to spawn ${cmd}: ${result.error.message}\n`);
    return 127;
  }
  return result.status ?? 1;
}

function scopeArgs(scope) {
  return scope ? ["--scope", scope] : [];
}

function runDoctor(stdout) {
  stdout.write("Running moe-doctor first...\n\n");
  const results = allProbes();
  for (const r of results) {
    const tag = r.ok ? "ok" : r.tier === "hard" ? "MISS" : "warn";
    const version = r.version ? ` (${r.version})` : "";
    stdout.write(`  [${tag}] ${r.name}${version}\n`);
    if (!r.ok && r.fixHint) stdout.write(`         fix: ${r.fixHint}\n`);
  }
  const exit = overallExit(results);
  stdout.write(
    exit === 0
      ? "\nDoctor passed. Proceeding with install.\n\n"
      : "\nDoctor found HARD gaps. Fix them and re-run.\n",
  );
  return exit;
}

/** Build the exact ordered command sequence for a lifecycle operation. */
export function lifecycleActions(mode, scope, version) {
  const scoped = scopeArgs(scope);
  const exactPackages = [UMBRELLA_PACKAGE, ...NPM_CLI_PACKAGES].map(
    (name) => `${name}@${version}`,
  );
  const latestPackages = [UMBRELLA_PACKAGE, ...NPM_CLI_PACKAGES].map(
    (name) => `${name}@latest`,
  );
  const actions = [];

  if (mode === "install") {
    // Persist the npx-delivered umbrella before its temporary cache disappears.
    actions.push(["npm", "install", "--global", ...exactPackages]);
    actions.push([
      "claude",
      "plugin",
      "marketplace",
      "add",
      MARKETPLACE.repository,
      "--sparse",
      ...MARKETPLACE.sparsePaths,
      ...scoped,
    ]);
    for (const plugin of MARKETPLACE.plugins) {
      actions.push(["claude", "plugin", "install", `${plugin}@${MARKETPLACE.name}`, ...scoped]);
    }
    return actions;
  }

  if (mode === "upgrade") {
    // Claude's marketplace update command does not accept --scope.
    actions.push(["claude", "plugin", "marketplace", "update", MARKETPLACE.name]);
    for (const plugin of MARKETPLACE.plugins) {
      actions.push(["claude", "plugin", "update", `${plugin}@${MARKETPLACE.name}`, ...scoped]);
    }
    // Replace the running global package last; the current installer stays stable.
    actions.push(["npm", "install", "--global", ...latestPackages]);
    return actions;
  }

  for (const plugin of MARKETPLACE.plugins) {
    actions.push(["claude", "plugin", "uninstall", `${plugin}@${MARKETPLACE.name}`, ...scoped]);
  }
  actions.push(["claude", "plugin", "marketplace", "remove", MARKETPLACE.name, ...scoped]);
  actions.push(["npm", "uninstall", "--global", ...NPM_CLI_PACKAGES]);
  // The command currently executing lives in this package. Remove it last.
  actions.push(["npm", "uninstall", "--global", UMBRELLA_PACKAGE]);
  return actions;
}

function doAction(actions, options) {
  for (const [cmd, ...args] of actions) {
    const status = run(cmd, args, options);
    if (status !== 0 && !options.dryRun) {
      options.stderr.write(`moe-install: ${cmd} ${args.join(" ")} exited ${status}\n`);
      return status;
    }
  }
  return 0;
}

export function main(argv = process.argv.slice(2), opts = {}) {
  const stdout = opts.stdout ?? process.stdout;
  const stderr = opts.stderr ?? process.stderr;
  const { flags, scope } = parseArgs(argv);

  if (flags.has("--help") || flags.has("-h")) {
    stdout.write(usage());
    return 0;
  }
  if (scope !== undefined && !["user", "project", "local"].includes(scope)) {
    stderr.write("moe-install: --scope must be user, project, or local\n");
    return 2;
  }

  const apply = flags.has("--apply");
  const skipDoctor = flags.has("--skip-doctor");
  let mode = "install";
  if (flags.has("--upgrade")) mode = "upgrade";
  else if (flags.has("--uninstall")) mode = "uninstall";

  let version;
  try {
    version = opts.version ?? packageVersion();
  } catch (error) {
    stderr.write(`moe-install: ${error.message}\n`);
    return 1;
  }
  const actions = lifecycleActions(mode, scope, version);
  stdout.write(`moe-install: mode=${mode}${scope ? ` scope=${scope}` : ""}\n\n`);

  if (!apply) {
    stdout.write("Plan (dry-run — re-run with --apply to execute):\n");
    const status = doAction(actions, {
      dryRun: true,
      stdout,
      stderr,
      spawn: opts.spawn,
      env: opts.env,
    });
    stdout.write(
      "\nCaveat: removing the marketplace from its last scope uninstalls every plugin from it.\n",
    );
    return status;
  }

  if (mode === "install" && !skipDoctor) {
    const doctorExit = runDoctor(stdout);
    if (doctorExit !== 0) return doctorExit;
  }

  return doAction(actions, {
    dryRun: false,
    stdout,
    stderr,
    spawn: opts.spawn,
    env: opts.env,
  });
}

const invokedDirectly = (() => {
  try {
    return realpathSync(process.argv[1]) === fileURLToPath(import.meta.url);
  } catch {
    return false;
  }
})();

if (invokedDirectly) process.exit(main());
