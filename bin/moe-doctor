#!/usr/bin/env node
// Harness-selected prerequisite probes for Moe. Dependency-free ESM.

import { platform } from "node:process";
import { HARNESS_IDS, selectHarness } from "./lib/plugin-registry.mjs";
import { allProbes, detectInstalledHarnesses, overallExit } from "./lib/probes.mjs";

function usage() {
  return [
    "moe-doctor — prerequisite probe for one Moe host harness.",
    "",
    "Usage:",
    "  moe-doctor --harness <adapter-id>  Probe requirements for that harness.",
    "  moe-doctor --json                  Emit the selected report as JSON.",
    "  moe-doctor --help                  Show this message.",
    "",
    `Adapter IDs: ${HARNESS_IDS.join(", ")}`,
    "Selection precedence: --harness, MOE_DEFAULT_HARNESS, sole installed host executable.",
    "Exit code: 0 if every HARD probe passes; 1 if a hard probe fails; 2 for usage/selection errors.",
    "Soft misses print a capability warning but never fail the exit.",
    "",
  ].join("\n");
}

function parseArgs(argv) {
  let harness;
  let json = false;
  let help = false;
  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    if (arg === "--help" || arg === "-h") help = true;
    else if (arg === "--json") json = true;
    else if (arg === "--harness") {
      const value = argv[++i];
      if (!value || value.startsWith("--")) return { error: "--harness requires a value" };
      if (harness !== undefined) return { error: "--harness may be provided only once" };
      harness = value;
    } else if (arg.startsWith("-")) return { error: `unknown option "${arg}"` };
    else return { error: `unexpected argument "${arg}"` };
  }
  return { harness, json, help };
}

function fail(message) {
  process.stderr.write(`moe-doctor: ${message}\n\n${usage()}`);
  process.exit(2);
}

const parsed = parseArgs(process.argv.slice(2));
if (parsed.error) fail(parsed.error);
if (parsed.help) {
  process.stdout.write(usage());
  process.exit(0);
}

const selection = selectHarness({
  explicit: parsed.harness,
  configuredDefault: process.env.MOE_DEFAULT_HARNESS || undefined,
  installed: detectInstalledHarnesses(),
});
if (selection.error) fail(selection.error);

const results = allProbes(selection.id);
if (parsed.json) {
  process.stdout.write(JSON.stringify({ platform, harness: selection.id, results }, null, 2) + "\n");
  process.exit(overallExit(results));
}

function badge(probe) {
  if (probe.ok) return "  ok  ";
  return probe.tier === "hard" ? " miss " : " warn ";
}

process.stdout.write(
  `moe-doctor — platform: ${platform}; harness: ${selection.id}; selected-by: ${selection.source}\n\n`,
);
for (const probe of results) {
  const version = probe.version ? `  (${probe.version}${probe.minVersion ? ` >= ${probe.minVersion}` : ""})` : "";
  process.stdout.write(`[${badge(probe)}] ${probe.name.padEnd(14)}${version}\n`);
  if (!probe.ok) {
    if (probe.capability) process.stdout.write(`         disables: ${probe.capability}\n`);
    if (probe.fixHint) process.stdout.write(`         fix:      ${probe.fixHint}\n`);
  }
}

const status = overallExit(results);
const hardMisses = results.filter((probe) => probe.tier === "hard" && !probe.ok).length;
const softMisses = results.filter((probe) => probe.tier === "soft" && !probe.ok).length;
process.stdout.write("\n");
if (status === 0 && softMisses === 0) process.stdout.write("All prerequisites present.\n");
else if (status === 0) {
  process.stdout.write(
    `Hard prerequisites present. ${softMisses} optional capability${softMisses === 1 ? "" : "s"} unavailable — see warnings above.\n`,
  );
} else {
  process.stdout.write(
    `${hardMisses} required prerequisite${hardMisses === 1 ? "" : "s"} missing for ${selection.id}.\n`,
  );
}
process.exit(status);
