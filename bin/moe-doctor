#!/usr/bin/env node
// moe-doctor — probe every prerequisite Moe cares about across macOS, Linux,
// WSL 2 and native Windows, name the capability each miss disables, and give
// one concrete fix per gap.
//
// Dependency-free ESM: `node bin/moe-doctor` works on a fresh checkout with
// nothing installed but Node. That is the correct shape for a diagnostic
// tool whose own dependencies could turn a "you're missing X" report into a
// stack trace about a missing module.
//
// Exit code: 0 if every HARD probe passes; 1 if any hard probe fails. Soft
// misses warn but never fail. `claude doctor` is the naming model.

import { platform } from 'node:process'
import { allProbes, overallExit } from './lib/probes.mjs'

const args = process.argv.slice(2)

if (args.includes('--help') || args.includes('-h')) {
  process.stdout.write(
    [
      'moe-doctor — prerequisite probe for Moe.',
      '',
      'Usage:',
      '  moe-doctor            Probe every prerequisite and print a report.',
      '  moe-doctor --json     Emit the probe results as JSON on stdout.',
      '  moe-doctor --help     Show this message.',
      '',
      'Exit code: 0 if every HARD probe passes; 1 if a hard probe fails.',
      'Soft misses (cargo, tmux, uv, chrome, docker, python3) print a',
      'capability warning but never fail the exit.',
      '',
    ].join('\n'),
  )
  process.exit(0)
}

const results = allProbes()

if (args.includes('--json')) {
  process.stdout.write(JSON.stringify({ platform, results }, null, 2) + '\n')
  process.exit(overallExit(results))
}

const OK = '  ok  '
const MISS = ' miss '
const WARN = ' warn '

function badge(r) {
  if (r.ok) return OK
  return r.tier === 'hard' ? MISS : WARN
}

process.stdout.write(`moe-doctor — platform: ${platform}\n\n`)

for (const r of results) {
  const tag = badge(r)
  const versionSuffix = r.version ? `  (${r.version}${r.minVersion ? ` >= ${r.minVersion}` : ''})` : ''
  const nameCol = r.name.padEnd(14)
  process.stdout.write(`[${tag}] ${nameCol}${versionSuffix}\n`)
  if (!r.ok) {
    if (r.capability) process.stdout.write(`         disables: ${r.capability}\n`)
    if (r.fixHint) process.stdout.write(`         fix:      ${r.fixHint}\n`)
  }
}

const exit = overallExit(results)
const hardMisses = results.filter((r) => r.tier === 'hard' && !r.ok).length
const softMisses = results.filter((r) => r.tier === 'soft' && !r.ok).length

process.stdout.write('\n')
if (exit === 0 && softMisses === 0) {
  process.stdout.write('All prerequisites present.\n')
} else if (exit === 0) {
  process.stdout.write(`Hard prerequisites present. ${softMisses} optional capability${softMisses === 1 ? '' : 's'} unavailable — see warnings above.\n`)
} else {
  process.stdout.write(`${hardMisses} required prerequisite${hardMisses === 1 ? '' : 's'} missing.\n`)
}

process.exit(exit)
