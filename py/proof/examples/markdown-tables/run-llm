#!/usr/bin/env bash
# Runner contract:
#   inputs:  $MOE_PROOF_MODEL, $MOE_PROOF_PROMPT, $MOE_PROOF_TASK, $MOE_PROOF_RUN_DIR
#   cwd:     the run directory - files written here are kept as artifacts
#   stdout:  the model's response (saved by moe-proof as output.txt)
#   exit:    non-zero marks the Run as failed
set -euo pipefail

llm -m "$MOE_PROOF_MODEL" "$MOE_PROOF_PROMPT"
llm logs -c --json > log.json
