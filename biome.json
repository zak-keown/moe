{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/dist", "!**/dist-static", "!plugins"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/packages/glass/**",
        "**/packages/mint/**",
        "**/packages/flight/src/qa/adapters/web/lib/**",
        "**/packages/flight/test/qa/adapters/web/lib/**"
      ],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "rules": {
          "recommended": false,
          "correctness": {
            "noUnusedVariables": "error",
            "noUnusedImports": "error",
            "noUnusedFunctionParameters": "warn"
          },
          "style": {
            "useConst": "error"
          },
          "suspicious": {
            "noVar": "error"
          }
        }
      },
      "assist": {
        "enabled": false
      }
    },
    {
      "includes": ["**/packages/crew/test/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/packages/tab/crates/moe-tab-core/prices/**",
        "**/packages/tab/crates/moe-tab-core/tests/fixtures/**",
        "**/packages/tab/bindings/testdata/**"
      ],
      "formatter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      }
    },
    {
      "includes": ["**/py/proof/**"],
      "linter": {
        "rules": {
          "recommended": false,
          "correctness": {
            "noUnusedVariables": "error",
            "noUnusedImports": "error",
            "noUnusedFunctionParameters": "warn"
          },
          "style": {
            "useConst": "error"
          },
          "suspicious": {
            "noVar": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/packages/core/skills/**",
        "**/packages/core/test/brainstorm-server/**",
        "**/packages/core/test/iterative-development/fixtures/**"
      ],
      "formatter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      },
      "linter": {
        "rules": {
          "recommended": false,
          "correctness": {
            "noUnusedVariables": "error",
            "noUnusedImports": "error"
          }
        }
      }
    },
    {
      "includes": ["**/packages/flight/dashboard/src/static/**"],
      "formatter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      },
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": ["**/packages/*/test/manual/**"],
      "formatter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      },
      "linter": {
        "enabled": false
      }
    }
  ]
}
