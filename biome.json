{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.references",
      "!plugins"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "//": "Inherited code. Upstream ran biome with the formatter OFF and recommended OFF, enabling four rules by name; this mirrors that so the import stays diffable against the pinned snapshot. Adopting house style here is a separate, isolated commit \u2014 never mixed with an import.",
      "includes": [
        "packages/glass/**"
      ],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "rules": {
          "recommended": false,
          "correctness": {
            "noUnusedVariables": "error",
            "noUnusedImports": "error",
            "noUnusedFunctionParameters": "warn"
          },
          "style": {
            "useConst": "error"
          },
          "suspicious": {
            "noVar": "error"
          }
        }
      }
    }
  ]
}
