# GitHub CODEOWNERS for github.com/zak-keown/moe.
#
# The audit filter that surfaces every AI-authored PR needs at least one
# required reviewer per touched area; otherwise the `AI` label alone is a
# filter with no enforcement behind it.
#
# GitHub enforces this only when the target branch has a protection rule with
# "Require review from Code Owners" enabled. Setting the file without setting
# the branch rule is decorative.

# Package-scoped areas. Each grouping stays local to its package so a fix in one
# does not require review across the tree.
/packages/core/            @zak-keown
/packages/backstory/       @zak-keown
/packages/crew/            @zak-keown
/packages/glass/           @zak-keown
/packages/memory/          @zak-keown
/packages/tab/             @zak-keown

# The generated /plugins/ tree is byte-checked in CI (`pnpm mint:check`); a
# hand-edit here is a source-of-truth drift, not a review-able change.
/plugins/                  @zak-keown

# Repo-wide policy files. Any change to the CI, PARITY, ARCHITECTURE or this
# file itself is a governance change and gets an owner review.
/.github/                  @zak-keown
/CODEOWNERS                @zak-keown
/PARITY.md                 @zak-keown
/ARCHITECTURE.md           @zak-keown
